# Wazi configuration. Copy to .env (git-ignored) or export in your shell.
# The values below are placeholders. Never commit real secrets.

# --- Inbound webhook security (Phase 4) ---
# Any string you choose. Meta sends it back during the GET handshake.
WAZI_WHATSAPP_VERIFY_TOKEN=
# Your Meta app's App Secret (used to verify X-Hub-Signature-256 on every POST).
WAZI_WHATSAPP_APP_SECRET=

# --- Outbound replies (Phase 5). Leave BOTH empty to run in dry-run mode: nothing is sent. ---
# WhatsApp Cloud API access token (system user or business token).
WAZI_WHATSAPP_ACCESS_TOKEN=
# The numeric phone number id of the sending WhatsApp business number (not the phone number).
WAZI_WHATSAPP_PHONE_NUMBER_ID=
# Optional. Defaults to v26.0.
# WAZI_GRAPH_API_VERSION=v26.0

# --- Server logging (optional) ---
# Used only by the server entry point (wazi.bootstrap:build_server_app). Default INFO.
# WAZI_LOG_LEVEL=INFO

# --- Persistence ---
# Optional path of the SQLite file that remembers processed message ids across restarts.
# Empty keeps an in-memory store (forgotten on restart).
WAZI_IDEMPOTENCY_DB=

# --- Live Meta tests only (tests/live, opt-in; they send ONE REAL WhatsApp message) ---
# WAZI_LIVE_META=1
# WAZI_LIVE_TEST_RECIPIENT=<digits of your own allowed test recipient>
